{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://artists-backend-production.up.railway.app/api/$1" },
    { "source": "/uploads/(.*)", "destination": "https://artists-backend-production.up.railway.app/uploads/$1" },
    { "source": "/((?!api/|uploads/).*)", "destination": "/index.html" }
  ]
}
