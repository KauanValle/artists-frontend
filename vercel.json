{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://artists-backend-uopm.onrender.com/api/$1" },
    { "source": "/uploads/(.*)", "destination": "https://artists-backend-uopm.onrender.com/uploads/$1" },
    { "source": "/((?!api/|uploads/).*)", "destination": "/index.html" }
  ]
}
